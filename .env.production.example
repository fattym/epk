# Production environment configuration
# Copy this to .env and update the values

# Django
SECRET_KEY=CHANGE-ME-TO-RANDOM-SECRET-KEY
DEBUG=False
ALLOWED_HOSTS=codingclubskenya.com,www.codingclubskenya.com,localhost

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=school_mgmt
DB_USER=school_user
DB_PASSWORD=CHANGE-ME
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=https://codingclubskenya.com,https://www.codingclubskenya.com

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# M-Pesa (Safaricom Daraja)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_BUSINESS_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://codingclubskenya.com/api/fees/mpesa/callback/
MPESA_ENVIRONMENT=sandbox

# AI Assist
AI_ASSIST_API_URL=
AI_ASSIST_API_KEY=
AI_ASSIST_MODEL=claude-3-5-sonnet-20240620

# Django settings
DJANGO_SETTINGS_MODULE=core.settings_production