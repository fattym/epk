[Unit]
Description=Next.js Distributor App
After=network.target

[Service]
Type=simple
User=school
Group=school
WorkingDirectory=/var/www/school_distributor
Environment="NODE_ENV=production"
Environment="PORT=3001"
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
